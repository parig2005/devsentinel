# ===========================================================================
# DevSentinel — environment template
#
# Copy this file to .env and fill in real values for your machine.
#   Windows (cmd):  copy .env.example .env
#   Windows (PS):   Copy-Item .env.example .env
#   macOS / Linux:  cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
#
# Every variable here has a working default in application.properties, so the
# project runs with H2 even if you skip this file entirely.
# ===========================================================================

# --- Web server ------------------------------------------------------------
SERVER_PORT=8080

# --- Database --------------------------------------------------------------
# DEFAULT (H2, no installation needed): leave these alone.
# The database file is created at ./data/devsentinel.mv.db on first run.
DB_USERNAME=sa
DB_PASSWORD=

# --- PostgreSQL (optional) -------------------------------------------------
# Only used when you start with --spring.profiles.active=postgres
# DB_URL=jdbc:postgresql://localhost:5432/devsentinel
# DB_USERNAME=postgres
# DB_PASSWORD=put-your-own-password-here

# --- Python AI service -----------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_CONNECT_TIMEOUT_MS=3000
AI_RESPONSE_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
# Cap on how many method snippets get sent to the AI service per file.
AI_MAX_SNIPPETS=25

# ===========================================================================
# Variables read by the Python AI service (ai-engine)
# Set these in the terminal where you start uvicorn.
# ===========================================================================

# Hugging Face model id. The default downloads ~500 MB on first run.
DEVSENTINEL_MODEL=microsoft/codebert-base

# cpu or cuda
DEVSENTINEL_DEVICE=cpu

# Set to 1 to start instantly in rule-only mode, skipping the model download.
# Useful on a slow connection or a laptop short on disk space.
DEVSENTINEL_SKIP_MODEL=0

# Snippets longer than this are truncated before inference.
DEVSENTINEL_MAX_SNIPPET_CHARS=20000
